#!/usr/bin/env sh
# --no-stash: lint-staged's backup stash goes into refs/stash, which is shared by every worktree of
# this repository (and is left behind when a hook fails). --hide-partially-staged keeps the
# unstaged half of partially staged files out of the commit. See CONTRIBUTING.md, "Working in
# shared worktrees".
npx lint-staged --no-stash --hide-partially-staged
